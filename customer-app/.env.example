EXPO_PUBLIC_API_BASE_URL=

# Dedicated MapTiler public key for the customer collecting map.
# Leave empty to show coordinates without requesting tiles. Do not put a server secret here.
# Restrict the key to User-Agent RidersCustomerMap and set a MapTiler spending limit.
# Commercial delivery use needs a paid MapTiler plan. tile.openstreetmap.org is not accepted.
EXPO_PUBLIC_MAP_TILE_KEY=

# Android Maps SDK key for the Track Delivery map in react-native-maps.
# Restrict it to this app's Android package. Leave empty until a new dev client is built.
# Do not put a server secret here. A new native build is required after this key changes.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
