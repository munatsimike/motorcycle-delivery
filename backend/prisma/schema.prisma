  nextVersion       Int?     @map("next_version")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User @relation("PricingAuditActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([actorId])
  @@map("pricing_config_audits")
}

enum CommissionModel {
  ON_COMPLETION
  ON_ACCEPTANCE

  @@map("commission_model")
}

// V1 offer timing. The V2 percentage is V2CommissionRate, not a column here.
model CommissionPolicy {
  id            String          @id @default(uuid(7)) @db.Uuid
  policyVersion Int             @unique @map("policy_version")
  model         CommissionModel @default(ON_COMPLETION)
  isActive      Boolean         @default(false) @map("is_active")
  createdById   String?         @map("created_by_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdById])
  @@map("commission_policies")
}

// One global percentage for Express and Flexible. Versions stay after a later publish.
// v2_commission_rates_one_active_idx and v2_commission_rates_basis_points_chk are
// SQL-only. Prisma 7.1.0 cannot represent them. Do not drop them in a later migration.
// No percentage is seeded.
model V2CommissionRate {
  id           String   @id @default(uuid(7)) @db.Uuid
  rateVersion  Int      @unique @map("rate_version")
  basisPoints  Int      @map("basis_points")
  isActive     Boolean  @default(false) @map("is_active")
  createdById  String   @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy User @relation("V2CommissionRateAuthor", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignments DeliveryAssignment[]

  @@index([createdById])
  @@map("v2_commission_rates")
}

// One row per publication. Previous basis points are null only for the first version.
// next_version is unique so history cannot contain two rows for one rate version.
model V2CommissionRateAudit {
  id                   String   @id @default(uuid(7)) @db.Uuid
  actorId              String   @map("actor_id") @db.Uuid
  previousVersion      Int?     @map("previous_version")
  nextVersion          Int      @unique @map("next_version")
  previousBasisPoints  Int?     @map("previous_basis_points")
  nextBasisPoints      Int      @map("next_basis_points")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User @relation("V2CommissionRateAuditor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([actorId])
  @@map("v2_commission_rate_audits")
}

enum V2OutboxEventType {
  BID_ACCEPTED
  REQUEST_REOPENED
  COLLECTING
  COLLECTED
  OUT_FOR_DELIVERY
  DELIVERED
  DEADLINE_REMINDER

  @@map("v2_outbox_event_type")
}

enum V2OutboxStatus {
  PENDING
  SENT
  FAILED

  @@map("v2_outbox_status")
}

// Durable V2 notices. One row per assignment and type.
// BID_ACCEPTED is the rider notice. Every other type is a customer notice.
// v2_outbox_events_recipient_chk is SQL-only. A worker claims due PENDING rows
// with FOR UPDATE SKIP LOCKED, sets claimed_at and claim_token, and commits
// before calling the push provider. The provider timeout stays inside the
// claim lease. Success sets SENT and sent_at. A genuine send failure
// increments attempt_count, records last_failure and last_attempt_at, and
// sets next_attempt_at. After the configured number of genuine failures the
// row becomes FAILED and failed_at is set. No device, and an unconfigured
// provider, leave the row PENDING and do not increment attempt_count.
// A provider acceptance followed by a crash before SENT is committed can be
// sent again after the lease. Exactly-once push delivery is not guaranteed.
// The worker does not change the delivery, assignment, bid, reservation, or wallet.
model V2OutboxEvent {
  id                String            @id @default(uuid(7)) @db.Uuid
  eventType         V2OutboxEventType @map("event_type")
  status            V2OutboxStatus    @default(PENDING)
  deliveryId        String            @map("delivery_id") @db.Uuid
  assignmentId      String            @map("assignment_id") @db.Uuid
  riderProfileId    String?           @map("rider_profile_id") @db.Uuid
  customerAccountId String?           @map("customer_account_id") @db.Uuid
  attemptCount      Int               @default(0) @map("attempt_count")
  claimedAt         DateTime?         @map("claimed_at") @db.Timestamptz(6)
  claimToken        String?           @map("claim_token") @db.Uuid
  nextAttemptAt     DateTime?         @map("next_attempt_at") @db.Timestamptz(6)
  lastFailure       String?           @map("last_failure") @db.VarChar(40)
  lastAttemptAt     DateTime?         @map("last_attempt_at") @db.Timestamptz(6)
  failedAt          DateTime?         @map("failed_at") @db.Timestamptz(6)
  sentAt            DateTime?         @map("sent_at") @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  delivery        Delivery           @relation(fields: [deliveryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignment      DeliveryAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  riderProfile    RiderProfile?      @relation(fields: [riderProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customerAccount CustomerAccount?   @relation(fields: [customerAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([assignmentId, eventType])
  @@index([status, createdAt])
  @@map("v2_outbox_events")
}



