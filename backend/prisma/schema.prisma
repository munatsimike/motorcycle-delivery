// Core motorcycle parcel delivery models for the NestJS modular monolith.
// Identity: User. Riders: RiderProfile, Motorcycle. Deliveries: Delivery,
// DeliveryAssignment, DeliveryStatusEvent.
//
// The initial migration also creates objects Prisma 7.1.0 cannot represent.
// Do not drop them in a later migration:
//   delivery_assignments_one_accepted_per_delivery_idx
//   delivery_assignments_one_accepted_per_rider_idx
//   delivery_assignments_one_open_offer_per_rider_idx
//   the named *_chk constraints
//   refresh_sessions_one_active_per_family_idx
//   users_passwordless_account_chk
//   rider_profiles_licence_verification_chk
//   rider_profiles_availability_requires_approval_chk
//   rider_licence_images_one_uploading_per_rider_idx
//   rider_licence_images_one_stored_per_rider_idx
//
// Acceptance, release, availability changes, competing-offer cancellation,
// and delivery status events are one NestJS transaction. This schema does
// not enforce those workflows with triggers.
//
// users.role is the single MVP role. A later user_roles table can replace it.
// Live GPS belongs in a later rider_locations table, not this schema.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  RIDER
  ADMIN

  @@map("user_role")
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("account_status")
}

enum RiderVerificationStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("rider_verification_status")
}

enum RiderApprovalStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED

  @@map("rider_approval_status")
}

enum RiderAvailability {
  OFFLINE
  AVAILABLE
  BUSY

  @@map("rider_availability")
}

enum MotorcycleVerificationStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("motorcycle_verification_status")
}

enum DeliveryType {
  PARCEL

  @@map("delivery_type")
}

enum DeliveryStatus {
  CREATED
  SEARCHING
  ASSIGNED
  ARRIVED_AT_PICKUP
  PICKED_UP
  IN_TRANSIT
  ARRIVED_AT_DROPOFF
  DELIVERED
  CANCELLED
  FAILED

  @@map("delivery_status")
}

enum AssignmentStatus {
  OFFERED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
  RELEASED
  COMPLETED
  FAILED

  @@map("assignment_status")
}

enum AssignmentReleaseReason {
  RIDER_CANCELLED
  VEHICLE_PROBLEM
  RIDER_UNRESPONSIVE
  ADMIN_REASSIGNED
  CUSTOMER_CANCELLED
  ADMIN_CANCELLED

  @@map("assignment_release_reason")
}

enum Currency {
  USD
  ZWG

  @@map("currency")
}

enum PaymentMethod {
  CASH
  ECOCASH
  ONEMONEY
  INNBUCKS
  ZIPIT

  @@map("payment_method")
}

enum DeliveryActorType {
  CUSTOMER
  RIDER
  ADMIN
  SYSTEM

  @@map("delivery_actor_type")
}

// Riders and customers are passwordless. The migration check
// users_passwordless_account_chk requires a null password hash for those
// roles, and phone_verified_at once the account is ACTIVE. Admins are excluded.
model User {
  id            String        @id @default(uuid(7)) @db.Uuid
  fullName      String        @map("full_name") @db.VarChar(200)
  phone         String        @unique @db.VarChar(20)
  email         String?       @unique @db.VarChar(254)
  passwordHash    String?       @map("password_hash") @db.VarChar(255)
  role            UserRole
  accountStatus   AccountStatus @default(PENDING) @map("account_status")
  phoneVerifiedAt DateTime?     @map("phone_verified_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  riderProfile          RiderProfile?         @relation("RiderAccount")
  reviewedRiderProfiles RiderProfile[]        @relation("LicenceReviewer")
  deliveries            Delivery[]            @relation("CustomerDeliveries")
  deliveryStatusEvents  DeliveryStatusEvent[]
  refreshSessions       RefreshSession[]

  @@index([role, accountStatus])
  @@map("users")
}

// Phone verification creates this row immediately. Licence verification,
// motorcycle verification, and rider approval stay separate. Zimbabwean
// licences have no expiry date, so a missing expiry is never stored or
// rejected. The migration check rider_profiles_licence_verification_chk
// requires a licence number, class, verification time, and reviewer only
// once verification_status is VERIFIED. Availability still requires approval.
model RiderProfile {
  id                 String                  @id @default(uuid(7)) @db.Uuid
  userId             String                  @unique @map("user_id") @db.Uuid
  verificationStatus RiderVerificationStatus @default(PENDING) @map("verification_status")
  approvalStatus     RiderApprovalStatus     @default(PENDING) @map("approval_status")
  availability       RiderAvailability       @default(OFFLINE)
  licenceNumber      String?                 @map("licence_number") @db.VarChar(50)
  licenceClass       String?                 @map("licence_class") @db.VarChar(40)
  verifiedAt         DateTime?               @map("verified_at") @db.Timestamptz(6)
  reviewerId         String?                 @map("reviewer_id") @db.Uuid
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User                   @relation("RiderAccount", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reviewer      User?                  @relation("LicenceReviewer", fields: [reviewerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  motorcycles   Motorcycle[]
  assignments   DeliveryAssignment[]
  licenceImages RiderLicenceImage[]

  @@index([approvalStatus, availability])
  @@index([reviewerId])
  @@map("rider_profiles")
}

model Motorcycle {
  id                 String                       @id @default(uuid(7)) @db.Uuid
  riderProfileId     String                       @map("rider_profile_id") @db.Uuid
  registrationNumber String                       @unique @map("registration_number") @db.VarChar(20)
  make               String                       @db.VarChar(80)
  model              String                       @db.VarChar(80)
  verificationStatus MotorcycleVerificationStatus @default(PENDING) @map("verification_status")
  createdAt          DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)

  riderProfile RiderProfile @relation(fields: [riderProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([riderProfileId, verificationStatus])
  @@map("motorcycles")
}

model Delivery {
  id                String         @id @default(uuid(7)) @db.Uuid
  customerId        String         @map("customer_id") @db.Uuid
  deliveryType      DeliveryType   @default(PARCEL) @map("delivery_type")
  pickupAddress     String         @map("pickup_address") @db.VarChar(500)
  pickupLatitude    Decimal        @map("pickup_latitude") @db.Decimal(10, 7)
  pickupLongitude   Decimal        @map("pickup_longitude") @db.Decimal(10, 7)
  dropoffAddress    String         @map("dropoff_address") @db.VarChar(500)
  dropoffLatitude   Decimal        @map("dropoff_latitude") @db.Decimal(10, 7)
  dropoffLongitude  Decimal        @map("dropoff_longitude") @db.Decimal(10, 7)
  parcelDescription String         @map("parcel_description") @db.VarChar(500)
  recipientName     String?        @map("recipient_name") @db.VarChar(200)
  recipientPhone    String?        @map("recipient_phone") @db.VarChar(20)
  price             Decimal        @db.Decimal(12, 2)
  currency          Currency       @default(USD)
  paymentMethod     PaymentMethod  @map("payment_method")
  status            DeliveryStatus @default(CREATED)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer     User                   @relation("CustomerDeliveries", fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignments  DeliveryAssignment[]
  statusEvents DeliveryStatusEvent[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@map("deliveries")
}

model DeliveryAssignment {
  id             String                   @id @default(uuid(7)) @db.Uuid
  deliveryId     String                   @map("delivery_id") @db.Uuid
  riderProfileId String                   @map("rider_profile_id") @db.Uuid
  status         AssignmentStatus         @default(OFFERED)
  offerExpiresAt DateTime                 @map("offer_expires_at") @db.Timestamptz(6)
  respondedAt    DateTime?                @map("responded_at") @db.Timestamptz(6)
  releaseReason  AssignmentReleaseReason? @map("release_reason")
  releasedAt     DateTime?                @map("released_at") @db.Timestamptz(6)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  delivery     Delivery     @relation(fields: [deliveryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  riderProfile RiderProfile @relation(fields: [riderProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([deliveryId, status])
  @@index([riderProfileId, status])
  @@index([offerExpiresAt])
  @@map("delivery_assignments")
}

model DeliveryStatusEvent {
  id             String            @id @default(uuid(7)) @db.Uuid
  deliveryId     String            @map("delivery_id") @db.Uuid
  previousStatus DeliveryStatus?   @map("previous_status")
  newStatus      DeliveryStatus    @map("new_status")
  actorId        String?           @map("actor_id") @db.Uuid
  actorType      DeliveryActorType @map("actor_type")
  occurredAt     DateTime          @default(now()) @map("occurred_at") @db.Timestamptz(6)

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([deliveryId, occurredAt])
  @@map("delivery_status_events")
}

enum AuthSubjectRole {
  RIDER
  CUSTOMER

  @@map("auth_subject_role")
}

enum AuthPurpose {
  REGISTRATION
  LOGIN

  @@map("auth_purpose")
}

enum AuthChallengeStatus {
  PENDING
  VERIFIED
  EXPIRED
  LOCKED
  SUPERSEDED

  @@map("auth_challenge_status")
}

model AuthChallenge {
  id            String              @id @default(uuid(7)) @db.Uuid
  phone         String              @db.VarChar(20)
  subjectRole   AuthSubjectRole     @map("subject_role")
  purpose       AuthPurpose
  fullName      String?             @map("full_name") @db.VarChar(200)
  twilioSid     String?             @map("twilio_sid") @db.VarChar(64)
  status        AuthChallengeStatus @default(PENDING)
  sendCount     Int                 @default(1) @map("send_count")
  checkAttempts Int                 @default(0) @map("check_attempts")
  lockedUntil   DateTime?           @map("locked_until") @db.Timestamptz(6)
  expiresAt     DateTime            @map("expires_at") @db.Timestamptz(6)
  ipHash        String?             @map("ip_hash") @db.Char(64)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phone, subjectRole, purpose, createdAt])
  @@index([ipHash, createdAt])
  @@map("auth_challenges")
}

model RefreshSession {
  id                  String    @id @default(uuid(7)) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  familyId            String    @map("family_id") @db.Uuid
  tokenHash           String    @unique @map("token_hash") @db.Char(64)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(6)
  familyExpiresAt     DateTime  @map("family_expires_at") @db.Timestamptz(6)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBySessionId String?   @unique @map("replaced_by_session_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  replacedBy  RefreshSession? @relation("RefreshRotation", fields: [replacedBySessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  replaces    RefreshSession? @relation("RefreshRotation")

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("refresh_sessions")
}

enum LicenceImageStatus {
  UPLOADING
  STORED
  SUPERSEDED
  PURGE_PENDING
  PURGED

  @@map("licence_image_status")
}

enum LicenceImageReviewStatus {
  PENDING

  @@map("licence_image_review_status")
}

// Private licence images. Bytes live in object storage. This phase never
// records a verified review here, and rider licence facts stay on RiderProfile.
model RiderLicenceImage {
  id             String                   @id @default(uuid(7)) @db.Uuid
  riderProfileId String                   @map("rider_profile_id") @db.Uuid
  objectKey      String                   @unique @map("object_key") @db.VarChar(200)
  contentType    String?                  @map("content_type") @db.VarChar(40)
  byteSize       Int?                     @map("byte_size")
  sha256         String?                  @db.Char(64)
  status         LicenceImageStatus       @default(UPLOADING)
  reviewStatus   LicenceImageReviewStatus @default(PENDING) @map("review_status")
  uploadedAt     DateTime?                @map("uploaded_at") @db.Timestamptz(6)
  supersededAt   DateTime?                @map("superseded_at") @db.Timestamptz(6)
  purgeAfter     DateTime?                @map("purge_after") @db.Timestamptz(6)
  purgedAt       DateTime?                @map("purged_at") @db.Timestamptz(6)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  riderProfile RiderProfile @relation(fields: [riderProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([riderProfileId, status])
  @@index([status, createdAt])
  @@index([status, purgeAfter])
  @@map("rider_licence_images")
}
