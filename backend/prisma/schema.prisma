enum LicenceImageStatus {
  UPLOADING
  STORED
  SUPERSEDED
  PURGE_PENDING
  PURGED

  @@map("licence_image_status")
}

enum LicenceImageReviewStatus {
  PENDING

  @@map("licence_image_review_status")
}

enum LicenceReviewDecision {
  VERIFY
  REJECT

  @@map("licence_review_decision")
}

// Private licence images. Bytes live in object storage. The image row stays
// PENDING. Verification facts and rejection reasons live on RiderProfile and
// in append-only RiderLicenceReview rows. The composite unique key is the
// target of the SQL-only rider_licence_reviews_image_owner_fkey.
model RiderLicenceImage {
  id             String                   @id @default(uuid(7)) @db.Uuid
  riderProfileId String                   @map("rider_profile_id") @db.Uuid
  objectKey      String                   @unique @map("object_key") @db.VarChar(200)
  contentType    String?                  @map("content_type") @db.VarChar(40)
  byteSize       Int?                     @map("byte_size")
  sha256         String?                  @db.Char(64)
  status         LicenceImageStatus       @default(UPLOADING)
  reviewStatus   LicenceImageReviewStatus @default(PENDING) @map("review_status")
  uploadedAt     DateTime?                @map("uploaded_at") @db.Timestamptz(6)
  supersededAt   DateTime?                @map("superseded_at") @db.Timestamptz(6)
  purgeAfter     DateTime?                @map("purge_after") @db.Timestamptz(6)
  purgedAt       DateTime?                @map("purged_at") @db.Timestamptz(6)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  riderProfile RiderProfile         @relation(fields: [riderProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reviews      RiderLicenceReview[]

  @@unique([id, riderProfileId], map: "rider_licence_images_id_rider_profile_id_key")
  @@index([riderProfileId, status])
  @@index([status, createdAt])
  @@index([status, purgeAfter])
  @@map("rider_licence_images")
}

// Append-only licence decisions. Prisma stores the simple image foreign key.
// rider_licence_reviews_image_owner_fkey also requires licence_image_id to
// belong to rider_profile_id. Do not add updatedAt or an update method.
model RiderLicenceReview {
  id              String                @id @default(uuid(7)) @db.Uuid
  riderProfileId  String                @map("rider_profile_id") @db.Uuid
  licenceImageId  String                @map("licence_image_id") @db.Uuid
  decision        LicenceReviewDecision
  licenceNumber   String?               @map("licence_number") @db.VarChar(50)
  licenceClass    String?               @map("licence_class") @db.VarChar(40)
  rejectionReason String?               @map("rejection_reason") @db.VarChar(500)
  reviewerId      String                @map("reviewer_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  riderProfile RiderProfile      @relation(fields: [riderProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  licenceImage RiderLicenceImage @relation(fields: [licenceImageId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reviewer     User              @relation("LicenceDecisionReviewer", fields: [reviewerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([riderProfileId, createdAt])
  @@index([licenceImageId])
  @@index([reviewerId])
  @@map("rider_licence_reviews")
}

enum WalletEntryType {
  WELCOME_BONUS
  TOP_UP
  PROMOTIONAL_CREDIT
  ADJUSTMENT
  PLATFORM_FEE_HOLD
  PLATFORM_FEE
  PLATFORM_FEE_RELEASE
  PLATFORM_FEE_REFUND

  @@map("wallet_entry_type")
}

enum WalletPaymentMethod {
  CASH
  ECOCASH
  GATEWAY

  @@map("wallet_payment_method")
}

enum WalletPaymentStatus {
  PENDING
  FAILED
  VERIFIED

  @@map("wallet_payment_status")
}

enum WalletTopUpRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("wallet_top_up_request_status")
}

enum WalletFeeReservationStatus {
  OPEN
  RELEASED
  CAPTURED

  @@map("wallet_fee_reservation_status")
}

enum WalletActorType {
  ADMIN
  RIDER
  SYSTEM

  @@map("wallet_actor_type")
}

// Versioned wallet settings. An admin change inserts the next version and
// deactivates the previous row. Amounts on an older row stay as stored.
// wallet_configs_one_active_idx allows one active row. The migration seeds
// version 1. Business logic must read the active row rather than hardcode it.
model WalletConfig {
  id                     String   @id @default(uuid(7)) @db.Uuid
  configVersion          Int      @unique @map("config_version")
  currency               Currency
  welcomeBonus           Decimal  @map("welcome_bonus") @db.Decimal(12, 2)
  defaultBorrowingLimit  Decimal  @map("default_borrowing_limit") @db.Decimal(12, 2)
  platformFee            Decimal  @map("platform_fee") @db.Decimal(12, 2)
  isActive               Boolean  @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById            String?  @map("created_by_id") @db.Uuid

  createdBy User?              @relation("WalletConfigAuthor", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  audits    WalletConfigAudit[]

  @@index([createdById])
  @@map("wallet_configs")
}

// One audit row per config version. Previous values are null only for the
// seeded version. Do not update or delete these rows.
model WalletConfigAudit {
  id                            String          @id @default(uuid(7)) @db.Uuid
  configVersion                 Int             @unique @map("config_version")
  actorType                     WalletActorType @map("actor_type")
  actorId                       String?         @map("actor_id") @db.Uuid
  previousWelcomeBonus          Decimal?        @map("previous_welcome_bonus") @db.Decimal(12, 2)
  previousDefaultBorrowingLimit Decimal?        @map("previous_default_borrowing_limit") @db.Decimal(12, 2)
  previousPlatformFee           Decimal?        @map("previous_platform_fee") @db.Decimal(12, 2)
  newWelcomeBonus               Decimal         @map("new_welcome_bonus") @db.Decimal(12, 2)
  newDefaultBorrowingLimit      Decimal         @map("new_default_borrowing_limit") @db.Decimal(12, 2)
  newPlatformFee                Decimal         @map("new_platform_fee") @db.Decimal(12, 2)
  createdAt                     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  config WalletConfig @relation(fields: [configVersion], references: [configVersion], onDelete: Restrict, onUpdate: Cascade)
  actor  User?        @relation("WalletConfigAuditor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([actorId])
  @@map("wallet_config_audits")
}

// One wallet per rider. welcome_bonus_awarded_at is the one-time entitlement
// marker. It is set without a credit for riders already APPROVED or SUSPENDED
// before this feature. balance is the ledger sum and may be negative.
model RiderWallet {
  id                      String    @id @default(uuid(7)) @db.Uuid
  riderProfileId          String    @unique @map("rider_profile_id") @db.Uuid
  currency                Currency
  balance                 Decimal   @db.Decimal(12, 2)
  borrowingLimitOverride  Decimal?  @map("borrowing_limit_override") @db.Decimal(12, 2)
  welcomeBonusAwardedAt   DateTime? @map("welcome_bonus_awarded_at") @db.Timestamptz(6)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  riderProfile        RiderProfile                @relation(fields: [riderProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  entries             RiderWalletEntry[]
  payments            WalletPayment[]
  topUpRequests       WalletTopUpRequest[]
  borrowingLimitAudits WalletBorrowingLimitAudit[]
  feeReservations     WalletFeeReservation[]

  @@map("rider_wallets")
}

// Append-only ledger. A reversal or fee release is a new compensating row.
// Do not update or delete an entry. idempotency_key is unique. A repeat with
// a different payload_hash is rejected by the application and cannot insert
// a second row for the same key.
model RiderWalletEntry {
  id               String          @id @default(uuid(7)) @db.Uuid
  riderWalletId    String          @map("rider_wallet_id") @db.Uuid
  entryType        WalletEntryType @map("entry_type")
  amount           Decimal         @db.Decimal(12, 2)
  balanceAfter     Decimal         @map("balance_after") @db.Decimal(12, 2)
  currency         Currency
  configVersion    Int             @map("config_version")
  idempotencyKey   String          @unique @map("idempotency_key") @db.VarChar(200)
  payloadHash      String          @map("payload_hash") @db.Char(64)
  walletPaymentId  String?         @unique @map("wallet_payment_id") @db.Uuid
  reason           String?         @db.VarChar(500)
  actorType        WalletActorType @map("actor_type")
  actorId          String?         @map("actor_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  riderWallet RiderWallet    @relation(fields: [riderWalletId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payment     WalletPayment? @relation(fields: [walletPaymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor       User?          @relation("WalletEntryActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([riderWalletId, createdAt])
  @@index([actorId])
  @@map("rider_wallet_entries")
}

// Collection and verification, separate from the ledger. CASH stores a unique
// internal receipt. ECOCASH stores a unique transaction reference. GATEWAY
// stores provider and provider_transaction_id for a later webhook. Only a
// VERIFIED payment may be linked to a ledger credit.
model WalletPayment {
  id                      String              @id @default(uuid(7)) @db.Uuid
  riderWalletId           String              @map("rider_wallet_id") @db.Uuid
  method                  WalletPaymentMethod
  status                  WalletPaymentStatus
  amount                  Decimal             @db.Decimal(12, 2)
  currency                Currency
  internalReceiptId       String?             @unique @map("internal_receipt_id") @db.VarChar(40)
  externalReceiptNumber   String?             @unique @map("external_receipt_number") @db.VarChar(64)
  ecocashReference        String?             @unique @map("ecocash_reference") @db.VarChar(64)
  provider                String?             @db.VarChar(40)
  providerTransactionId   String?             @map("provider_transaction_id") @db.VarChar(120)
  idempotencyKey          String              @unique @map("idempotency_key") @db.VarChar(200)
  payloadHash             String              @map("payload_hash") @db.Char(64)
  topUpRequestId          String?             @unique @map("top_up_request_id") @db.Uuid
  confirmedById           String?             @map("confirmed_by_id") @db.Uuid
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  verifiedAt              DateTime?           @map("verified_at") @db.Timestamptz(6)

  riderWallet RiderWallet         @relation(fields: [riderWalletId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  confirmedBy User?               @relation("WalletPaymentConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  topUpRequest WalletTopUpRequest? @relation(fields: [topUpRequestId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  entry       RiderWalletEntry?

  @@unique([provider, providerTransactionId])
  @@index([riderWalletId, createdAt])
  @@index([confirmedById])
  @@map("wallet_payments")
}

// A request does not credit a wallet. Approval is a later verified payment.
model WalletTopUpRequest {
  id                String                   @id @default(uuid(7)) @db.Uuid
  riderWalletId     String                   @map("rider_wallet_id") @db.Uuid
  amount            Decimal                  @db.Decimal(12, 2)
  method            WalletPaymentMethod
  ecocashReference  String?                  @map("ecocash_reference") @db.VarChar(64)
  status            WalletTopUpRequestStatus @default(PENDING)
  rejectionReason   String?                  @map("rejection_reason") @db.VarChar(500)
  reviewedById      String?                  @map("reviewed_by_id") @db.Uuid
  reviewedAt        DateTime?                @map("reviewed_at") @db.Timestamptz(6)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  riderWallet RiderWallet                  @relation(fields: [riderWalletId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reviewedBy  User?                        @relation("WalletTopUpReviewer", fields: [reviewedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  events      WalletTopUpRequestEvent[]
  payment     WalletPayment?

  @@index([riderWalletId, status, createdAt])
  @@index([reviewedById])
  @@map("wallet_top_up_requests")
}

// Append-only request history. The request row holds the current status.
model WalletTopUpRequestEvent {
  id             String                    @id @default(uuid(7)) @db.Uuid
  requestId      String                    @map("request_id") @db.Uuid
  previousStatus WalletTopUpRequestStatus? @map("previous_status")
  newStatus      WalletTopUpRequestStatus  @map("new_status")
  actorType      WalletActorType           @map("actor_type")
  actorId        String?                   @map("actor_id") @db.Uuid
  reason         String?                   @db.VarChar(500)
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  request WalletTopUpRequest @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([requestId, createdAt])
  @@map("wallet_top_up_request_events")
}

// Records an override change. It does not change the wallet balance.
model WalletBorrowingLimitAudit {
  id                String   @id @default(uuid(7)) @db.Uuid
  riderWalletId     String   @map("rider_wallet_id") @db.Uuid
  actorId           String   @map("actor_id") @db.Uuid
  previousOverride  Decimal? @map("previous_override") @db.Decimal(12, 2)
  newOverride       Decimal? @map("new_override") @db.Decimal(12, 2)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  riderWallet RiderWallet @relation(fields: [riderWalletId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor       User        @relation("BorrowingLimitAuditor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([riderWalletId, createdAt])
  @@index([actorId])
  @@map("wallet_borrowing_limit_audits")
}

// Created when a rider accepts a delivery with a positive platform fee.
// OPEN reduces capacity and posts no ledger entry. RELEASED posts no ledger
// entry. CAPTURED is paired with one negative PLATFORM_FEE entry for the
// amount and configuration version stored on this row.
model WalletFeeReservation {
  id            String                     @id @default(uuid(7)) @db.Uuid
  riderWalletId String                     @map("rider_wallet_id") @db.Uuid
  deliveryId    String?                    @map("delivery_id") @db.Uuid
  assignmentId  String?                    @unique @map("assignment_id") @db.Uuid
  amount        Decimal                    @db.Decimal(12, 2)
  currency      Currency
  configVersion Int                        @map("config_version")
  status        WalletFeeReservationStatus @default(OPEN)
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  releasedAt    DateTime?                  @map("released_at") @db.Timestamptz(6)
  capturedAt    DateTime?                  @map("captured_at") @db.Timestamptz(6)

  riderWallet RiderWallet @relation(fields: [riderWalletId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  delivery    Delivery?   @relation(fields: [deliveryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([riderWalletId, status])
  @@index([deliveryId])
  @@map("wallet_fee_reservations")
}




