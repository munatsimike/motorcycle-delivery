// Core motorcycle parcel delivery models for the NestJS modular monolith.
// Identity: User. Riders: RiderProfile, Motorcycle. Deliveries: Delivery,
// DeliveryAssignment, DeliveryStatusEvent.
//
// The initial migration also creates objects Prisma 7.1.0 cannot represent.
// Do not drop them in a later migration:
//   delivery_assignments_one_accepted_per_delivery_idx
//   delivery_assignments_one_live_express_per_rider_idx WHERE status = ACCEPTED AND service_class = EXPRESS
//   delivery_assignments_one_accepted_v1_per_rider_idx WHERE status = ACCEPTED AND accepted_bid_amount IS NULL
//   delivery_assignments_one_open_offer_per_rider_idx
//   the named *_chk constraints
//   refresh_sessions_one_active_per_family_idx
//   users_account_credential_chk
//   rider_profiles_licence_verification_chk
//   rider_profiles_availability_requires_approval_chk
//   rider_licence_images_one_uploading_per_rider_idx
//   rider_licence_images_one_stored_per_rider_idx
//   motorcycles_identity_chk
//   motorcycles_verification_chk
//   motorcycles_active_requires_verified_chk
//   motorcycles_one_active_per_rider_idx
//   delivery_assignments_motorcycle_owner_fkey
//   delivery_assignments_motorcycle_chk
//   rider_licence_reviews_decision_chk
//   rider_licence_reviews_image_owner_fkey
//   rider_licence_reviews_append_only
//   customer_accounts_kind_chk
//   delivery_pricing_configs_one_active_idx
//   delivery_pricing_configs_usd_chk
//   delivery_pricing_configs_fee_chk
//   delivery_pricing_configs_distance_chk
//   deliveries_suggested_price_nonnegative_chk
//   deliveries_distance_meters_nonnegative_chk
//   deliveries_pricing_version_chk
//   deliveries_pickup_contact_phone_e164_chk
//   deliveries_creation_text_chk
//   wallet_configs_one_active_idx
//   wallet_configs_usd_chk
//   wallet_configs_amount_chk
//   wallet_config_audits_actor_chk
//   wallet_config_audits_values_chk
//   wallet_config_audits_append_only
//   rider_wallets_usd_chk
//   rider_wallets_override_chk
//   rider_wallet_entries_shape_chk
//   rider_wallet_entries_one_welcome_bonus_idx
//   rider_wallet_entries_append_only
//   wallet_payments_shape_chk
//   wallet_top_up_requests_shape_chk
//   wallet_top_up_request_events_append_only
//   wallet_borrowing_limit_audits_change_chk
//   wallet_borrowing_limit_audits_append_only
//   wallet_fee_reservations_status_chk
//   wallet_fee_reservations_one_open_per_delivery_idx
//   rider_locations_position geography(Point,4326)
//   rider_locations_position_gix
//   rider_locations_coordinate_chk
//   delivery_dispatch_rounds_round_chk
//   delivery_dispatch_rounds_status_chk
//   deliveries_search_generation_chk
//   delivery_assignments_accept_idempotency_chk
//   delivery_assignments_accepted_fee_chk
//   v2_commission_rates_one_active_idx
//   v2_commission_rates_basis_points_chk
//   v2_commission_rate_audits_basis_points_chk
//   v2_commission_rate_audits_next_version_key
//   delivery_assignments_v2_commission_snapshot_chk
//   delivery_assignments_v2_commission_snapshot_immutable
//   bids_one_open_per_rider_delivery_idx
//   bids_one_accepted_per_delivery_idx WHERE status = ACCEPTED AND closed_at IS NULL
//   v2_outbox_events_recipient_chk
//   bids_idempotency_key_key
//   bids_amount_nonnegative_chk
//   bids_currency_usd_chk
//   bids_idempotency_pair_chk
//
// Phase 4B dropped delivery_assignments_one_accepted_per_rider_idx. Do not
// recreate that broad index. A rider may hold many Flexible ACCEPTED rows.
// One live Express ACCEPTED row and one V1 ACCEPTED row are the partial
// indexes above. Prisma cannot represent them.
//
// V1 accept sets BUSY. V2 acceptance leaves availability and
// receiving_requests unchanged.
//
// Prisma 7.1.0 cannot represent the SQL-only composite foreign keys
// delivery_assignments_motorcycle_owner_fkey and
// rider_licence_reviews_image_owner_fkey. prisma migrate diff may propose
// dropping either constraint. Remove that DROP CONSTRAINT statement from any
// future generated migration before applying it. The trigger
// rider_licence_reviews_append_only only rejects UPDATE and DELETE. Do not
// drop it, and do not use triggers for review or approval workflow.
//
// Acceptance, release, availability changes, competing-offer cancellation,
// and delivery status events are one NestJS transaction. This schema does
// not enforce those workflows with triggers.
//
// Motorcycle selection locks the rider profile, then that rider's motorcycle
// rows. It does not lock deliveries. Going online or offline uses that same
// lock order and rechecks the operational predicate. It does not lock
// deliveries or set BUSY. Licence replacement and licence review lock the
// rider profile, then that rider's licence images. Approval locks the rider
// profile and then reads motorcycles. Accept still locks the delivery, then
// the rider profile, then the assignment, then the rider wallet, and rechecks
// the operational predicate before storing motorcycle_id on the ACCEPTED row.
// Capture locks the rider profile again and then the wallet. It reads the
// assignment fee snapshot without locking the delivery or the assignment,
// because the caller already holds those locks in that order. Release and
// cancellation use the same delivery, profile, assignment, then wallet order
// and do not clear the snapshot.
// That predicate requires an active account, a verified phone, approved
// rider status, a verified licence, and exactly one active verified
// motorcycle. Approval itself does not require the active motorcycle.
//
// users.role is the single MVP role. A later user_roles table can replace it.
// A CustomerAccount is a capability on a RIDER or CUSTOMER user, not a new
// role. Deliveries belong to that account. A later membership table can
// attach more users to the same account id without moving deliveries.
// Live GPS is one current point in rider_locations. Prisma stores latitude
// and longitude. position geography(Point,4326) and rider_locations_position_gix
// are SQL-only, so a generated diff may propose dropping them. Remove that
// DROP before applying it. Location updates go through parameterized SQL so
// the geography point stays aligned. There is no location history.
//
// The platform service fee lives on wallet_configs. Accepting a delivery
// stores that fee and its configuration version on the assignment, including
// 0.00. A positive fee also inserts an OPEN wallet_fee_reservations row, which
// reduces capacity and does not change the balance or post a ledger entry. A
// zero fee does not insert a reservation row. Releasing a reservation does not
// post a ledger entry and does not clear the assignment snapshot. Capture posts
// one negative PLATFORM_FEE for the snapshotted amount. The fee must never
// debit deliveries.price or deliveries.suggested_price. Wallet history is
// append-only. A reversal is a new compensating rider_wallet_entries row. Do
// not update or delete a historical entry.
// Delivery creation locks the active pricing config, then inserts the
// delivery and its CREATED status event. It does not lock riders or insert
// an assignment. delivery_pricing_configs_one_active_idx is SQL-only.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  RIDER
  ADMIN

  @@map("user_role")
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("account_status")
}

enum RiderVerificationStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("rider_verification_status")
}

enum RiderApprovalStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED

  @@map("rider_approval_status")
}

enum RiderAvailability {
  OFFLINE
  AVAILABLE
  BUSY

  @@map("rider_availability")
}

enum MotorcycleVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  REVOKED

  @@map("motorcycle_verification_status")
}

enum DeliveryType {
  PARCEL

  @@map("delivery_type")
}

enum ParcelSize {
  SMALL
  MEDIUM
  LARGE

  @@map("parcel_size")
}

enum DeliveryPayer {
  SENDER
  RECIPIENT

  @@map("delivery_payer")
}

enum DeliveryStatus {
  CREATED
  SEARCHING
  NO_RIDER_FOUND
  ASSIGNED
  RIDER_ASSIGNED
  COLLECTING
  COLLECTED
  OUT_FOR_DELIVERY
  ARRIVED_AT_PICKUP
  PICKED_UP
  IN_TRANSIT
  ARRIVED_AT_DROPOFF
  DELIVERED
  CANCELLED
  FAILED

  @@map("delivery_status")
}

// UNREVIEWED is not an exemption from Google coordinate retention.
// Existing rows use it because the stored point does not say which provider produced it.
enum CoordinateSource {
  GOOGLE_PLACES
  DEVICE_GEOCODER
  UNREVIEWED

  @@map("coordinate_source")
}

enum AssignmentStatus {
  OFFERED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
  RELEASED
  COMPLETED
  FAILED

  @@map("assignment_status")
}

enum AssignmentReleaseReason {
  RIDER_CANCELLED
  VEHICLE_PROBLEM
  RIDER_UNRESPONSIVE
  ADMIN_REASSIGNED
  CUSTOMER_CANCELLED
  ADMIN_CANCELLED
  PAYMENT_NOT_AGREED
  PARCEL_NOT_AS_DESCRIBED
  PARCEL_TOO_LARGE
  SENDER_UNAVAILABLE
  WRONG_ADDRESS
  BREAKDOWN
  OTHER

  @@map("assignment_release_reason")
}

enum Currency {
  USD
  ZWG

  @@map("currency")
}

enum PaymentMethod {
  CASH
  ECOCASH
  ONEMONEY
  INNBUCKS
  ZIPIT

  @@map("payment_method")
}

enum DeliveryActorType {
  CUSTOMER
  RIDER
  ADMIN
  SYSTEM

  @@map("delivery_actor_type")
}

// Customers and riders sign in with WhatsApp. password_hash is admin-only.
// users_account_credential_chk requires a verified phone for an ACTIVE customer
// or rider and forbids a password hash on those roles. Admins are excluded.
model User {
  id            String        @id @default(uuid(7)) @db.Uuid
  fullName      String        @map("full_name") @db.VarChar(200)
  phone         String        @unique @db.VarChar(20)
  email         String?       @unique @db.VarChar(254)
  passwordHash      String?       @map("password_hash") @db.VarChar(255)
  role              UserRole
  accountStatus     AccountStatus @default(PENDING) @map("account_status")
  phoneVerifiedAt   DateTime?     @map("phone_verified_at") @db.Timestamptz(6)
  whatsappConsentAt DateTime?     @map("whatsapp_consent_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  riderProfile          RiderProfile?         @relation("RiderAccount")
  reviewedRiderProfiles RiderProfile[]        @relation("LicenceReviewer")
  verifiedMotorcycles   Motorcycle[]          @relation("MotorcycleVerifier")
  rejectedMotorcycles   Motorcycle[]          @relation("MotorcycleRejector")
  revokedMotorcycles    Motorcycle[]          @relation("MotorcycleRevoker")
  customerAccount         CustomerAccount?
  authoredDeliveryPricing DeliveryPricingConfig[] @relation("DeliveryPricingAuthor")
  authoredWalletConfigs   WalletConfig[]          @relation("WalletConfigAuthor")
  walletConfigAudits      WalletConfigAudit[]     @relation("WalletConfigAuditor")
  confirmedWalletPayments WalletPayment[]         @relation("WalletPaymentConfirmer")
  reviewedTopUpRequests   WalletTopUpRequest[]    @relation("WalletTopUpReviewer")
  walletEntries           RiderWalletEntry[]      @relation("WalletEntryActor")
  borrowingLimitAudits    WalletBorrowingLimitAudit[] @relation("BorrowingLimitAuditor")
  deliveryStatusEvents    DeliveryStatusEvent[]
  refreshSessions       RefreshSession[]
  adminLoginChallenges AdminLoginChallenge[] @relation("AdminLoginChallenges")
  licenceReviews        RiderLicenceReview[]  @relation("LicenceDecisionReviewer")
  pricingAudits         PricingConfigAudit[]  @relation("PricingAuditActor")
  authoredV2CommissionRates V2CommissionRate[] @relation("V2CommissionRateAuthor")
  v2CommissionRateAudits V2CommissionRateAudit[] @relation("V2CommissionRateAuditor")

  @@index([role, accountStatus])
  @@map("users")
}

// Registration creates this row when the account is finished. Licence verification,
// motorcycle verification, and rider approval stay separate. Zimbabwean
// licences have no expiry date, so a missing expiry is never stored or
// rejected. The migration check rider_profiles_licence_verification_chk
// requires a licence number, class, verification time, and reviewer only
// once verification_status is VERIFIED. Availability still requires approval.
model RiderProfile {
  id                 String                  @id @default(uuid(7)) @db.Uuid
  userId             String                  @unique @map("user_id") @db.Uuid
  verificationStatus RiderVerificationStatus @default(PENDING) @map("verification_status")
  approvalStatus     RiderApprovalStatus     @default(PENDING) @map("approval_status")
  availability       RiderAvailability       @default(OFFLINE)
  // Null until the V2 marketplace flag is on. V1 online/offline does not read this.
  receivingRequests  Boolean?                @map("receiving_requests")
  licenceNumber      String?                 @map("licence_number") @db.VarChar(50)
  licenceClass       String?                 @map("licence_class") @db.VarChar(40)
  verifiedAt         DateTime?               @map("verified_at") @db.Timestamptz(6)
  reviewerId         String?                 @map("reviewer_id") @db.Uuid
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User                   @relation("RiderAccount", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reviewer      User?                  @relation("LicenceReviewer", fields: [reviewerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  motorcycles    Motorcycle[]
  assignments    DeliveryAssignment[]
  licenceImages  RiderLicenceImage[]
  licenceReviews RiderLicenceReview[]
  wallet         RiderWallet?
  location       RiderLocation?
  pushDevices    RiderPushDevice[]
  offerNotifications RiderOfferNotification[]
  bids               Bid[]
  v2OutboxEvents     V2OutboxEvent[]
  progressCommands   DeliveryProgressCommand[]

  @@index([approvalStatus, availability])
  @@index([reviewerId])
  @@map("rider_profiles")
}

// Many motorcycles per rider. At most one is active, and only while VERIFIED.
// The composite unique key is the target of delivery_assignments_motorcycle_owner_fkey.
model Motorcycle {
  id                 String                       @id @default(uuid(7)) @db.Uuid
  riderProfileId     String                       @map("rider_profile_id") @db.Uuid
  registrationNumber String                       @unique @map("registration_number") @db.VarChar(20)
  make               String                       @db.VarChar(80)
  model              String                       @db.VarChar(80)
  colour             String                       @db.VarChar(40)
  verificationStatus MotorcycleVerificationStatus @default(PENDING) @map("verification_status")
  isActive           Boolean                      @default(false) @map("is_active")
  verifiedAt         DateTime?                    @map("verified_at") @db.Timestamptz(6)
  verifiedById       String?                      @map("verified_by_id") @db.Uuid
  rejectedAt         DateTime?                    @map("rejected_at") @db.Timestamptz(6)
  rejectedById       String?                      @map("rejected_by_id") @db.Uuid
  revokedAt          DateTime?                    @map("revoked_at") @db.Timestamptz(6)
  revokedById        String?                      @map("revoked_by_id") @db.Uuid
  createdAt          DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)

  riderProfile RiderProfile @relation(fields: [riderProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  verifiedBy   User?        @relation("MotorcycleVerifier", fields: [verifiedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rejectedBy   User?        @relation("MotorcycleRejector", fields: [rejectedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  revokedBy    User?        @relation("MotorcycleRevoker", fields: [revokedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, riderProfileId], map: "motorcycles_id_rider_profile_id_key")
  @@index([riderProfileId, verificationStatus])
  @@map("motorcycles")
}

enum PricingModel {
  FIXED
  PER_KILOMETRE
  BASE_PLUS_PER_KILOMETRE
  DISTANCE_TIERS

  @@map("pricing_model")
}

// Versions are append-only. An admin change deactivates the current row and
// inserts the next pricing_version. Fee columns on an older row stay as stored.
// A null service_class is the V1 tariff. Express and Flexible are separate rows.
// Prisma cannot represent the partial unique indexes. Do not drop them:
//   delivery_pricing_configs_one_active_v1_idx
//   delivery_pricing_configs_one_active_per_class_idx
// The migration does not seed a tariff.
model DeliveryPricingConfig {
  id                 String        @id @default(uuid(7)) @db.Uuid
  pricingVersion     Int           @unique @map("pricing_version")
  pricingModel       PricingModel  @default(BASE_PLUS_PER_KILOMETRE) @map("pricing_model")
  serviceClass       ServiceClass? @map("service_class")
  currency           Currency
  baseFee            Decimal       @map("base_fee") @db.Decimal(12, 2)
  pricePerKilometre  Decimal       @map("price_per_kilometre") @db.Decimal(12, 2)
  minimumTripMetres  Int           @map("minimum_trip_metres")
  maximumTripMetres  Int           @map("maximum_trip_metres")
  isActive           Boolean       @map("is_active")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById        String        @map("created_by_id") @db.Uuid

  createdBy User                  @relation("DeliveryPricingAuthor", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  windows   PricingWindow[]
  tiers     PricingDistanceTier[]

  @@index([createdById])
  @@map("delivery_pricing_configs")
}

model Delivery {
  id                String         @id @default(uuid(7)) @db.Uuid
  customerId        String         @map("customer_id") @db.Uuid
  deliveryType      DeliveryType   @default(PARCEL) @map("delivery_type")
  pickupAddress        String         @map("pickup_address") @db.VarChar(500)
  pickupLatitude       Decimal?       @map("pickup_latitude") @db.Decimal(10, 7)
  pickupLongitude      Decimal?       @map("pickup_longitude") @db.Decimal(10, 7)
  pickupPlaceId        String?        @map("pickup_place_id") @db.VarChar(255)
  pickupCoordinateSource CoordinateSource @map("pickup_coordinate_source")
  pickupCoordinateRetrievedAt DateTime? @map("pickup_coordinate_retrieved_at") @db.Timestamptz(6)
  pickupCoordinateRefreshAttemptedAt DateTime? @map("pickup_coordinate_refresh_attempted_at") @db.Timestamptz(6)
  pickupLandmark       String?        @map("pickup_landmark") @db.VarChar(200)
  pickupInstructions   String?        @map("pickup_instructions") @db.VarChar(500)
  pickupContactName    String         @map("pickup_contact_name") @db.VarChar(200)
  pickupContactPhone   String         @map("pickup_contact_phone") @db.VarChar(20)
  dropoffAddress       String         @map("dropoff_address") @db.VarChar(500)
  dropoffLatitude      Decimal?       @map("dropoff_latitude") @db.Decimal(10, 7)
  dropoffLongitude     Decimal?       @map("dropoff_longitude") @db.Decimal(10, 7)
  dropoffPlaceId       String?        @map("dropoff_place_id") @db.VarChar(255)
  dropoffCoordinateSource CoordinateSource @map("dropoff_coordinate_source")
  dropoffCoordinateRetrievedAt DateTime? @map("dropoff_coordinate_retrieved_at") @db.Timestamptz(6)
  dropoffCoordinateRefreshAttemptedAt DateTime? @map("dropoff_coordinate_refresh_attempted_at") @db.Timestamptz(6)
  dropoffLandmark      String?        @map("dropoff_landmark") @db.VarChar(200)
  dropoffInstructions  String?        @map("dropoff_instructions") @db.VarChar(500)
  parcelDescription    String         @map("parcel_description") @db.VarChar(500)
  parcelSize           ParcelSize     @map("parcel_size")
  parcelInstructions   String?        @map("parcel_instructions") @db.VarChar(500)
  recipientName        String         @map("recipient_name") @db.VarChar(200)
  recipientPhone       String         @map("recipient_phone") @db.VarChar(20)
  // Null on a V2 request until a bid is accepted. V1 create still writes a price.
  price                Decimal?       @db.Decimal(12, 2)
  suggestedPrice       Decimal        @map("suggested_price") @db.Decimal(12, 2)
  distanceMeters       Int            @map("distance_meters")
  pricingVersion       Int            @map("pricing_version")
  // Null on a V2 request. V1 create still writes both. V2 pricing does not read them.
  payer                DeliveryPayer?
  currency             Currency       @default(USD)
  paymentMethod        PaymentMethod? @map("payment_method")
  // Pricing snapshot for a V2 request. Null on V1 rows.
  pricingModel         PricingModel?  @map("pricing_model")
  pricingBasisPoints   Int?           @map("pricing_basis_points")
  pricingWindowId      String?        @map("pricing_window_id") @db.Uuid
  // Unused while V2 marketplace is disabled. Existing rows stay null.
  serviceClass      ServiceClass?  @map("service_class")
  deliverBy         DateTime?      @map("deliver_by") @db.Timestamptz(6)
  status            DeliveryStatus @default(CREATED)
  // Customer searches and rider releases each start a new generation.
  // Generation 0 means nobody has searched yet.
  searchGeneration  Int            @default(0) @map("search_generation")
 autoRetryCount Int       @default(0) @map("auto_retry_count")
 nextRetryAt    DateTime? @map("next_retry_at") @db.Timestamptz(6)
 searchStartedAt DateTime? @map("search_started_at") @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer        CustomerAccount        @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pricingWindow   PricingWindow?         @relation(fields: [pricingWindowId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignments     DeliveryAssignment[]
  statusEvents    DeliveryStatusEvent[]
  bids            Bid[]
  feeReservations WalletFeeReservation[]
  dispatchRounds  DeliveryDispatchRound[]
  v2OutboxEvents  V2OutboxEvent[]
  progressCommands DeliveryProgressCommand[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@map("deliveries")
}

// One row. The retention pass claims it so two processes cannot delete
// coordinates at the same time. This table stores no coordinates.
model CoordinateRetentionLock {
  id          Int       @id
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)
  owner       String?   @db.Uuid

  @@map("coordinate_retention_lock")
}

model DeliveryAssignment {
  id             String                   @id @default(uuid(7)) @db.Uuid
  deliveryId     String                   @map("delivery_id") @db.Uuid
  riderProfileId String                   @map("rider_profile_id") @db.Uuid
  // Null until ACCEPTED. Prisma 7.1.0 cannot represent the SQL-only composite
  // foreign key delivery_assignments_motorcycle_owner_fkey on
  // (motorcycle_id, rider_profile_id). prisma migrate diff may propose
  // dropping it. Remove that DROP CONSTRAINT statement from any future
  // generated migration before applying it. Pre-accept statuses must stay null.
  motorcycleId   String?                  @map("motorcycle_id") @db.Uuid
  status         AssignmentStatus         @default(OFFERED)
  offerExpiresAt DateTime                 @map("offer_expires_at") @db.Timestamptz(6)
  respondedAt    DateTime?                @map("responded_at") @db.Timestamptz(6)
  releaseReason    AssignmentReleaseReason? @map("release_reason")
  releasedAt       DateTime?                @map("released_at") @db.Timestamptz(6)
  // V2 pre-pickup cancellation. The rider on this row is the actor.
  cancellationNote String? @map("cancellation_note") @db.VarChar(500)
  cancellationStage DeliveryStatus? @map("cancellation_stage")
  cancellationIdempotencyKey String? @unique @map("cancellation_idempotency_key") @db.VarChar(200)
  cancellationPayloadHash String? @map("cancellation_payload_hash") @db.Char(64)
  // Set on offers so a later generation can exclude riders already contacted
  // in the current wave. Null on rows created before progressive dispatch.
  searchGeneration Int?                     @map("search_generation")
  idempotencyKey   String?                  @unique @map("idempotency_key") @db.VarChar(200)
  payloadHash      String?                  @map("payload_hash") @db.Char(64)
  // Null until ACCEPTED. Set from the same fee and configuration version used
  // to open the reservation, including 0.00. Release and completion keep them.
  acceptedPlatformFee      Decimal? @map("accepted_platform_fee") @db.Decimal(12, 2)
  acceptedFeeConfigVersion Int?     @map("accepted_fee_config_version")
  acceptedCommissionModel CommissionModel? @map("accepted_commission_model")
  acceptedCommissionPolicyVersion Int? @map("accepted_commission_policy_version")
  // Copied from the delivery when a V2 bid is accepted. Null on V1 offers.
  serviceClass ServiceClass? @map("service_class")
  // Null until a V2 bid is accepted. The four values are written together and
  // the SQL trigger delivery_assignments_v2_commission_snapshot_immutable
  // rejects later changes. V1 fee columns above are a different snapshot.
  acceptedBidAmount                 Decimal? @map("accepted_bid_amount") @db.Decimal(12, 2)
  acceptedCommissionBasisPoints     Int?     @map("accepted_commission_basis_points")
  acceptedV2CommissionRateVersion   Int?     @map("accepted_v2_commission_rate_version")
  acceptedCommissionAmount          Decimal? @map("accepted_commission_amount") @db.Decimal(12, 2)
  // The bid this acceptance committed. Replay reads this after closed_at is set.
  acceptedBidId    String?                  @unique @map("accepted_bid_id") @db.Uuid
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  delivery     Delivery     @relation(fields: [deliveryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  riderProfile RiderProfile @relation(fields: [riderProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  acceptedBid  Bid?         @relation(fields: [acceptedBidId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  v2OutboxEvents V2OutboxEvent[]
  progressCommands DeliveryProgressCommand[]
  offerNotification RiderOfferNotification?
  v2CommissionRate V2CommissionRate? @relation(fields: [acceptedV2CommissionRateVersion], references: [rateVersion], onDelete: Restrict, onUpdate: Restrict)

  @@index([deliveryId, status])
  @@index([riderProfileId, status])
  @@index([motorcycleId])
  @@index([offerExpiresAt])
  @@map("delivery_assignments")
}

// One row per V2 status command. The acceptance idempotency key stays on the
// assignment and is not written here. A matching key and payload returns this
// row and does not advance the delivery again.
model DeliveryProgressCommand {
  id              String            @id @default(uuid(7)) @db.Uuid
  idempotencyKey  String            @unique @map("idempotency_key") @db.VarChar(200)
  payloadHash     String            @map("payload_hash") @db.Char(64)
  riderProfileId  String            @map("rider_profile_id") @db.Uuid
  deliveryId      String            @map("delivery_id") @db.Uuid
  assignmentId    String            @map("assignment_id") @db.Uuid
  requestedStatus DeliveryStatus    @map("requested_status")
  resultStatus    DeliveryStatus    @map("result_status")
  availability    RiderAvailability
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  riderProfile RiderProfile       @relation(fields: [riderProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  delivery     Delivery           @relation(fields: [deliveryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignment   DeliveryAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([assignmentId])
  @@map("delivery_progress_commands")
}

// One current point per rider. position geography(Point,4326) and its GiST
// index are created by SQL and are not fields here. Do not store history.
model RiderLocation {
  riderProfileId String   @id @map("rider_profile_id") @db.Uuid
  latitude       Decimal  @db.Decimal(10, 7)
  longitude      Decimal  @db.Decimal(10, 7)
  updatedAt      DateTime @map("updated_at") @db.Timestamptz(6)

  riderProfile RiderProfile @relation(fields: [riderProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("rider_locations")
}

enum DispatchRoundStatus {
  PENDING
  COMPLETED

  @@map("dispatch_round_status")
}

// One row per radius in a search generation. The worker claims PENDING rows
// whose due time has arrived. Offers and the COMPLETED mark share a transaction.
model DeliveryDispatchRound {
  id               String              @id @default(uuid(7)) @db.Uuid
  deliveryId       String              @map("delivery_id") @db.Uuid
  searchGeneration Int                 @map("search_generation")
  roundNumber      Int                 @map("round_number")
  radiusMetres     Int                 @map("radius_metres")
  dueAt            DateTime            @map("due_at") @db.Timestamptz(6)
  status           DispatchRoundStatus @default(PENDING)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt      DateTime?           @map("completed_at") @db.Timestamptz(6)

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([deliveryId, searchGeneration, roundNumber], map: "delivery_dispatch_rounds_generation_round_key")
  @@index([status, dueAt])
  @@map("delivery_dispatch_rounds")
}

model DeliveryStatusEvent {
  id             String            @id @default(uuid(7)) @db.Uuid
  deliveryId     String            @map("delivery_id") @db.Uuid
  previousStatus DeliveryStatus?   @map("previous_status")
  newStatus      DeliveryStatus    @map("new_status")
  actorId        String?           @map("actor_id") @db.Uuid
  actorType      DeliveryActorType @map("actor_type")
  occurredAt     DateTime          @default(now()) @map("occurred_at") @db.Timestamptz(6)

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([deliveryId, occurredAt])
  @@map("delivery_status_events")
}

enum CustomerAccountKind {
  INDIVIDUAL
  BUSINESS

  @@map("customer_account_kind")
}

// One login per account for the MVP. user_id is unique so a rider and a
// customer profile share one user without a second phone. A later membership
// table can grant more users access to this same id. Do not move deliveries
// back onto users. Account kind is fixed after creation.
model CustomerAccount {
  id          String              @id @default(uuid(7)) @db.Uuid
  userId      String              @unique @map("user_id") @db.Uuid
