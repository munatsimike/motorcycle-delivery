  contactName String?             @map("contact_name") @db.VarChar(200)
  address     String              @db.VarChar(500)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  deliveries Delivery[]
  pushDevices CustomerPushDevice[]
  fcmDevices CustomerFcmDevice[]
  v2OutboxEvents V2OutboxEvent[]
  riderAvailabilityAlerts RiderAvailabilityAlert[]

  @@map("customer_accounts")
}

enum RiderAvailabilityAlertStatus {
  ACTIVE
  SENDING
  NOTIFIED
  CANCELLED
  EXPIRED

  @@map("rider_availability_alert_status")
}

// One Expo push token per device. A token can move to the signed-in customer.
// invalidated_at is set when Expo reports the token is no longer registered.
model CustomerPushDevice {
  id                String    @id @default(uuid(7)) @db.Uuid
  customerAccountId String    @map("customer_account_id") @db.Uuid
  expoPushToken     String    @unique @map("expo_push_token") @db.VarChar(255)
  invalidatedAt     DateTime? @map("invalidated_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([customerAccountId])
  @@map("customer_push_devices")
}

// One FCM token per customer app install. This is separate from rider FCM
// tokens and from the Expo tokens used by availability alerts. Registration
// moves the token onto the signed-in customer. A delete must also match
// customer_account_id so another customer cannot remove it.
model CustomerFcmDevice {
  id                String    @id @default(uuid(7)) @db.Uuid
  customerAccountId String    @map("customer_account_id") @db.Uuid
  fcmToken          String    @unique @map("fcm_token") @db.VarChar(512)
  invalidatedAt     DateTime? @map("invalidated_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([customerAccountId])
  @@map("customer_fcm_devices")
}

// One open alert per customer. position geography(Point,4326) and its GiST index
// are created by SQL and are not fields here. The alert watches the same 2 km
// nearby-rider rule. It does not reserve or assign a rider.
model RiderAvailabilityAlert {
  id                String                       @id @default(uuid(7)) @db.Uuid
  customerAccountId String                       @map("customer_account_id") @db.Uuid
  latitude          Decimal                      @db.Decimal(10, 7)
  longitude         Decimal                      @db.Decimal(10, 7)
  radiusMetres      Int                          @default(2000) @map("radius_metres")
  status            RiderAvailabilityAlertStatus @default(ACTIVE)
  createdAt         DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt         DateTime                     @map("expires_at") @db.Timestamptz(6)
  claimedAt         DateTime?                    @map("claimed_at") @db.Timestamptz(6)
  notifiedAt        DateTime?                    @map("notified_at") @db.Timestamptz(6)
  nextAttemptAt     DateTime?                    @map("next_attempt_at") @db.Timestamptz(6)
  attemptCount      Int                          @default(0) @map("attempt_count")
  lastFailure       String?                      @map("last_failure") @db.VarChar(40)

  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([status, expiresAt])
  @@map("rider_availability_alerts")
}

enum RiderOfferNotificationStatus {
  PENDING
  SENDING
  SENT
  SKIPPED

  @@map("rider_offer_notification_status")
}

// One alert per offered assignment. The row is written in the same transaction
// as the OFFERED assignment and is sent only after that transaction commits.
// rider_offer_notifications_pending_idx and rider_offer_notifications_sending_idx
// are partial indexes in SQL. Do not drop them in a generated diff.
model RiderOfferNotification {
  id             String                        @id @default(uuid(7)) @db.Uuid
  assignmentId   String                        @unique @map("assignment_id") @db.Uuid
  riderProfileId String                        @map("rider_profile_id") @db.Uuid
  status         RiderOfferNotificationStatus  @default(PENDING)
  attemptCount   Int                           @default(0) @map("attempt_count")
  nextAttemptAt  DateTime                      @map("next_attempt_at") @db.Timestamptz(6)
  claimedAt      DateTime?                     @map("claimed_at") @db.Timestamptz(6)
  sentAt         DateTime?                     @map("sent_at") @db.Timestamptz(6)
  skipReason     String?                       @map("skip_reason") @db.VarChar(40)
  lastFailure    String?                       @map("last_failure") @db.VarChar(40)
  createdAt      DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)

  assignment   DeliveryAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  riderProfile RiderProfile       @relation(fields: [riderProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("rider_offer_notifications")
}

// One FCM token per app install. Registration moves the token onto the
// signed-in rider. A delete must also match rider_profile_id so an old
// session cannot remove another rider's token.
model RiderPushDevice {
  id             String    @id @default(uuid(7)) @db.Uuid
  riderProfileId String    @map("rider_profile_id") @db.Uuid
  fcmToken       String    @unique @map("fcm_token") @db.VarChar(512)
  invalidatedAt  DateTime? @map("invalidated_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  riderProfile RiderProfile @relation(fields: [riderProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([riderProfileId])
  @@map("rider_push_devices")
}

