// V2 marketplace tables. No application code writes these while V2_MARKETPLACE_ENABLED is off.
enum ServiceClass {
  EXPRESS
  FLEXIBLE

  @@map("service_class")
}

enum BidStatus {
  OPEN
  WITHDRAWN
  ACCEPTED
  SUPERSEDED
  EXPIRED

  @@map("bid_status")
}

enum PricingWindowKind {
  PEAK
  OFF_PEAK
  NIGHT

  @@map("pricing_window_kind")
}

model Bid {
  id             String    @id @default(uuid(7)) @db.Uuid
  deliveryId     String    @map("delivery_id") @db.Uuid
  riderProfileId String    @map("rider_profile_id") @db.Uuid
  amount         Decimal   @db.Decimal(12, 2)
  currency       Currency  @default(USD)
  status         BidStatus
  // Set when a pre-pickup cancellation ends this acceptance. The status stays
  // ACCEPTED. The partial unique index ignores a closed row, so a later bid
  // on the reopened delivery can be accepted.
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(6)
  // Both null or both set. A replay of the key returns the first bid.
  idempotencyKey String?   @unique @map("idempotency_key") @db.VarChar(200)
  payloadHash    String?   @map("payload_hash") @db.Char(64)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  delivery     Delivery     @relation(fields: [deliveryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  riderProfile RiderProfile @relation(fields: [riderProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  acceptedAssignments DeliveryAssignment[]

  @@index([deliveryId, status])
  @@index([riderProfileId, status])
  @@map("bids")
}

model PricingWindow {
