# Copy to .env and replace the placeholders. Do not commit .env.

# Comma-separated CIDRs of reverse proxies allowed to set the client IP.
# Leave this empty for local development. A direct connection that sends
# X-Forwarded-For or X-Real-IP is ignored. Do not use 0.0.0.0/0.
TRUSTED_PROXY_CIDRS=

# Set to true only for the Railway service behind its public HTTP ingress.
# Leave false locally. NODE_ENV does not turn this on. While true, the OTP
# address is the single X-Real-IP value. The environment must contain only
# this API. Review this before adding a private-network service, TCP proxy,
# or any other ingress path.
TRUST_RAILWAY_EDGE_CLIENT_IP=false

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/delivery_db

# Firebase service account JSON for rider alerts and customer delivery notices.
# Leave empty locally. Do not commit the JSON. The same Firebase project must own the Android apps.
FIREBASE_SERVICE_ACCOUNT_JSON=

# PEM of the database root CA. Leave this empty for local PostgreSQL.
# On Railway, set the Supabase Root 2021 CA. Certificate verification stays enabled.
DATABASE_SSL_CA=

# Geoapify road distance and static map previews.
# This key stays on the server. Do not put it in the mobile app.
GEOAPIFY_API_KEY=

# Google Places API (New) address suggestions and selected-place coordinates.
# This key stays on the server. Do not put it in the mobile app.
GOOGLE_MAPS_API_KEY=

# Twilio Verify account for WhatsApp customer and rider authentication.
# SMS OTP is not used. The auth token stays on the server. Do not put a sender number or a code here.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# WhatsApp verification for customer and rider registration and sign-in.
# Leave this false until the Verify service has a WhatsApp channel and the flow has been tested.
# There is no SMS fallback when this is false or the Verify request fails.
# provider is twilio today. meta is reserved for the WhatsApp Cloud API and is not active.
# The sender is the approved WhatsApp business number in E.164. It is required and is not hardcoded.
# Twilio Verify uses the sender configured on the Verify service. This value is checked, not sent as a From number.
WHATSAPP_VERIFICATION_ENABLED=false
WHATSAPP_VERIFICATION_PROVIDER=twilio
WHATSAPP_VERIFICATION_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_VERIFICATION_SENDER=+263000000000

# Local mock OTP. Leave this false. It works only when NODE_ENV=development,
# this value is exactly true, and WhatsApp verification is false. The API
# refuses to start if it is true on production, staging, Railway, or any
# other hosted deployment. The code is printed on the backend terminal and
# is not returned by the API. See docs/local-dev-otp.md.
DEV_OTP_ENABLED=false

# HMAC secret for 15-minute access tokens. At least 32 characters.
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900

# Local testing only. Dutch +316 mobile numbers are accepted when this is
# true and NODE_ENV=development. Production ignores this flag.
ALLOW_TEST_NL_PHONE_NUMBERS=false

# Local development only. The issue-dev-admin script also requires
# NODE_ENV=development. It creates a separate admin and prints one session.
# Revoke that session afterwards with POST /auth/session/logout-all.
ALLOW_DEV_ADMIN_BOOTSTRAP=false

# Private licence images. Local development uses the MinIO bucket from
# docker compose. Replace the endpoint and credentials for production.
LICENCE_STORAGE_BUCKET=licence-images
LICENCE_STORAGE_ENDPOINT=http://localhost:9000
LICENCE_STORAGE_REGION=us-east-1
LICENCE_STORAGE_ACCESS_KEY_ID=licence-dev
LICENCE_STORAGE_SECRET_ACCESS_KEY=licence-dev-password
LICENCE_STORAGE_MAX_BYTES=5242880
LICENCE_SUPERSEDED_RETENTION_DAYS=90
LICENCE_CLEANUP_INTERVAL_SECONDS=300

# Google coordinate retention. Keep this false on the API process. true is the
# only value that would also start the in-process interval, and that would be a
# second scheduler. Do not enable it.
#
# The retention pass runs only when invoked:
#   npm run retention:once
# That command runs the existing pass once and exits. It does not start the
# HTTP server, dispatch, or other background jobs. Run it from this directory
# so it loads this env file, including GOOGLE_MAPS_API_KEY. That key stays on
# the server and is not part of the customer app.
#
# Production schedule: run the same command once immediately after boot or an
# outage, then once an hour. Example cron, with the working directory set to
# this backend folder:
#   @reboot npm run retention:once
#   0 * * * * npm run retention:once
# The database lease makes an overlapping run exit without a second cleanup.
# Alert if an hour passes with no finished result, or if the process exits
# nonzero. Coordinates are cleared 6 hours 15 minutes before the 30-day limit.
COORDINATE_RETENTION_ENABLED=false
COORDINATE_RETENTION_INTERVAL_SECONDS=3600
