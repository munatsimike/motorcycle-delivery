# Backend origin with no trailing slash. Leave empty to call same-origin paths
# (Vite proxies /auth and /customers to the local Nest server during development).
# Production should use the same HTTPS origin as this site, or an approved CORS origin.
# Do not put API keys, OTP secrets, or other credentials here.
VITE_API_BASE_URL=

# Google Maps JavaScript key used in the browser. Leave empty to hide maps.
# Restrict the key to this site's HTTPS origin. Do not put a server-side Maps key here.
VITE_GOOGLE_MAPS_BROWSER_KEY=
